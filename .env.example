# Host IP address where the container binds.
# Use 127.0.0.1 behind Cloudflare Tunnel/reverse proxy, or 0.0.0.0 for direct LAN access.
BIND_ADDRESS=127.0.0.1

# Host port exposed to access the web interface
PORT=3000

# Public or local URL of your Jellyfin server (optional).
# Example: https://jellyfin.yourdomain.com or http://192.168.1.50:8096
# If left empty, users can enter it from the connection wizard on first visit.
JELLYFIN_SERVER_URL=

# Global brand customization (optional).
# Sets the app title and custom logo URL (https://, http://, or a /local-path).
# If left empty, the UI defaults to "MorphPlay" and its built-in SVG logo.
APP_NAME=MorphPlay
APP_LOGO_URL=
