# Dirección IP del host donde escucha el contenedor.
# Usa 127.0.0.1 detrás de Cloudflare Tunnel/proxy inverso, o 0.0.0.0 para acceso directo en LAN.
BIND_ADDRESS=127.0.0.1

# Puerto expuesto en el equipo anfitrión para acceder a la interfaz web
PORT=3000

# URL pública o local de tu servidor Jellyfin (opcional).
# Ejemplo: https://jellyfin.tudominio.com o http://192.168.1.50:8096
# Si se deja vacío, el usuario podrá ingresarla desde el asistente web al entrar por primera vez.
JELLYFIN_SERVER_URL=

# Personalización global de marca (opcional).
# Permite definir el título de la aplicación y la URL de un logotipo personalizado (https://, http:// o /ruta-local).
# Si se dejan vacíos, la interfaz usa la marca predeterminada "MorphPlay" y su logotipo SVG integrado.
APP_NAME=MorphPlay
APP_LOGO_URL=
